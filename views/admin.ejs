<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=yes">
    <title>License Server - Админ панель</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="/css/admin.css">
    <style>
        /* Дополнительные стили для уведомлений */
        .alert {
            padding: 16px;
            border-radius: 12px;
            margin-bottom: 20px;
        }
        .alert-info {
            background: #d1ecf1;
            color: #0c5460;
            border: 1px solid #bee5eb;
        }
        .alert-info i {
            margin-right: 8px;
        }
    </style>
</head>
<body>
<!-- Sidebar -->
<div class="sidebar">
    <div class="sidebar-header">
        <h3><i class="bi bi-shield-lock"></i><span class="menu-text"> License Server</span></h3>
        <p class="menu-text">Административная панель</p>
    </div>
    <div class="sidebar-menu">
        <a id="menuModules" class="active"><i class="bi bi-grid-3x3-gap-fill"></i><span class="menu-text"> Модули</span></a>
        <a id="menuLicenses"><i class="bi bi-key-fill"></i><span class="menu-text"> Лицензии</span></a>
        <a id="menuNews"><i class="bi bi-newspaper"></i><span class="menu-text"> Новости</span></a>
    </div>
    <div class="sidebar-divider"></div>
    <div class="sidebar-menu">
        <a id="logoutLink"><i class="bi bi-box-arrow-right"></i><span class="menu-text"> Выход</span></a>
    </div>
</div>

<!-- Main Content -->
<div class="main-content">
    <div id="mainContent">
        <div class="text-center" style="padding: 60px 20px;">
            <i class="bi bi-shield-check" style="font-size: 64px; color: #4ecdc4;"></i>
            <h2 style="margin-top: 20px;">Добро пожаловать</h2>
            <p class="text-muted">Выберите раздел в меню слева</p>
        </div>
    </div>
</div>

<!-- Modal для модуля -->
<div class="modal-fullscreen" id="moduleModal">
    <div class="modal-container">
        <div class="modal-header">
            <h3 id="moduleModalTitle">Создание модуля</h3>
            <button class="close-btn" id="closeModalBtn">&times;</button>
        </div>
        <div class="modal-body">
            <form id="moduleForm">
                <input type="hidden" id="moduleId">
                <div class="row">
                    <div class="col-6">
                        <div class="form-group">
                            <label class="form-label">Заголовок *</label>
                            <input type="text" id="moduleTitle" class="form-control" required>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Описание</label>
                            <textarea id="moduleDescription" class="form-control" rows="4"></textarea>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Превью</label>
                            <input type="file" id="previewImageFile" class="form-control" accept="image/*">
                            <div id="previewContainer" class="mt-2"></div>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Файл модуля</label>
                            <input type="file" id="moduleFile" class="form-control">
                            <small class="text-muted">ZIP, RAR, APK, EXE и др.</small>
                        </div>
                        <div class="form-group">
                            <label class="form-label">URL файла</label>
                            <input type="text" id="moduleFileUrl" class="form-control">
                        </div>
                        <div class="form-group">
                            <label class="form-label">Версия *</label>
                            <input type="text" id="moduleVersion" class="form-control" required>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="form-group">
                            <label class="form-label">Галерея</label>
                            <input type="file" id="galleryImageInput" class="form-control" accept="image/*" multiple>
                            <div id="galleryContainer" class="gallery-horizontal mt-2"></div>
                        </div>
                    </div>
                </div>
            </form>
        </div>
        <div class="modal-footer">
            <button class="btn btn-secondary" id="cancelModalBtn">Отмена</button>
            <button class="btn btn-primary" id="saveModuleBtn">Сохранить</button>
        </div>
    </div>
</div>

<!-- Modal для новости -->
<div class="modal-fullscreen" id="newsModal">
    <div class="modal-container" style="max-width: 700px;">
        <div class="modal-header">
            <h3 id="newsModalTitle">Добавить новость</h3>
            <button class="close-btn" id="closeNewsModalBtn">&times;</button>
        </div>
        <div class="modal-body">
            <form id="newsForm">
                <input type="hidden" id="newsId">
                <div class="form-group">
                    <label class="form-label">Модуль</label>
                    <select id="newsModuleId" class="form-control">
                        <option value="">-- Все модули --</option>
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label">Заголовок *</label>
                    <input type="text" id="newsTitle" class="form-control" required>
                </div>
                <div class="form-group">
                    <label class="form-label">Картинка</label>
                    <input type="file" id="newsImageFile" class="form-control" accept="image/*">
                    <div id="newsPreviewContainer" class="mt-2"></div>
                </div>
                <div class="form-group">
                    <label class="form-label">Текст *</label>
                    <textarea id="newsContent" class="form-control" rows="8" required></textarea>
                </div>
            </form>
        </div>
        <div class="modal-footer">
            <button class="btn btn-secondary" id="cancelNewsModalBtn">Отмена</button>
            <button class="btn btn-primary" id="saveNewsBtn">Сохранить</button>
        </div>
    </div>
</div>

<script src="/js/admin.js"></script>
</body>
</html>