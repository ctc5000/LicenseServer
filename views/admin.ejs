<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes">
    <meta name="theme-color" content="#1a1a2e">
    <title>Админ-панель | Управление модулями</title>

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

    <!-- Основные стили -->
    <% if (isProduction) { %>
        <link rel="stylesheet" href="/css/admin.min.css">
    <% } else { %>
        <link rel="stylesheet" href="/css/admin.css">
    <% } %>

    <!-- Дополнительные стили для модалок и галереи -->
    <style>
        /* Базовые стили для модалок, если не загрузились основные */
        .modal-fullscreen {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.5);
            z-index: 1000;
            backdrop-filter: blur(4px);
        }
        .modal-fullscreen.show {
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .modal-container {
            background: #fff;
            width: 90%;
            max-width: 1000px;
            max-height: 85vh;
            border-radius: 20px;
            display: flex;
            flex-direction: column;
            overflow: hidden;
            box-shadow: 0 20px 40px rgba(0,0,0,0.2);
        }
        .menu-toggle {
            display: none;
            position: fixed;
            top: 16px;
            left: 16px;
            z-index: 1001;
            background: #4ecdc4;
            color: white;
            border: none;
            border-radius: 8px;
            padding: 8px 12px;
            cursor: pointer;
        }
        @media (max-width: 768px) {
            .menu-toggle {
                display: block;
            }
        }
    </style>
</head>
<body>

<!-- Мобильное меню кнопка -->
<button class="menu-toggle" onclick="toggleSidebar()">
    <i class="bi bi-list"></i>
</button>

<!-- Sidebar -->
<div class="sidebar">
    <div class="sidebar-header">
        <h3>
            <i class="bi bi-shield-lock-fill"></i>
            Админ-панель
        </h3>
        <p>Управление модулями и лицензиями</p>
    </div>

    <div class="sidebar-menu">
        <a id="menuModules" class="active">
            <i class="bi bi-grid-3x3-gap-fill"></i>
            <span>Модули</span>
        </a>
        <a id="menuLicenses">
            <i class="bi bi-key-fill"></i>
            <span>Лицензии</span>
        </a>
        <a id="menuNews">
            <i class="bi bi-newspaper"></i>
            <span>Новости</span>
        </a>

        <div class="sidebar-divider"></div>

        <a id="logoutLink">
            <i class="bi bi-box-arrow-right"></i>
            <span>Выход</span>
        </a>
    </div>
</div>

<!-- Main Content -->
<div class="main-content" id="mainContent">
    <div class="text-center p-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Загрузка...</span>
        </div>
        <p class="mt-3">Загрузка данных...</p>
    </div>
</div>

<!-- Modal for Module -->
<div id="moduleModal" class="modal-fullscreen" style="display: none;">
    <div class="modal-container">
        <div class="modal-header">
            <h3 id="moduleModalTitle">Модуль</h3>
            <button type="button" class="close-btn" id="closeModalBtn">&times;</button>
        </div>
        <div class="modal-body">
            <form id="moduleForm">
                <input type="hidden" id="moduleId">

                <div class="row">
                    <div class="col-6">
                        <div class="form-group">
                            <label class="form-label">Название модуля *</label>
                            <input type="text" id="moduleTitle" class="form-control" required>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="form-group">
                            <label class="form-label">Версия *</label>
                            <input type="text" id="moduleVersion" class="form-control" placeholder="1.0.0" required>
                        </div>
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label">Описание</label>
                    <textarea id="moduleDescription" class="form-control" rows="3"></textarea>
                </div>

                <div class="row">
                    <div class="col-6">
                        <div class="form-group">
                            <label class="form-label">Превью изображение</label>
                            <div class="custom-file-input">
                                <div class="file-input-wrapper">
                                    <input type="file" id="previewImageFile" accept="image/*">
                                    <label for="previewImageFile" class="file-input-label">
                                        <i class="bi bi-image"></i>
                                        <span class="file-name">Выберите изображение...</span>
                                        <span class="btn-browse">Обзор</span>
                                    </label>
                                </div>
                            </div>
                            <input type="hidden" id="modulePreview">
                            <div id="previewContainer" class="preview-container">
                                <div class="preview-placeholder">
                                    <i class="bi bi-image"></i>
                                    <p>Нет изображения</p>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="form-group">
                            <label class="form-label">Файл модуля</label>
                            <div class="custom-file-input">
                                <div class="file-input-wrapper">
                                    <input type="file" id="moduleFile">
                                    <label for="moduleFile" class="file-input-label">
                                        <i class="bi bi-file-zip"></i>
                                        <span class="file-name">Выберите файл...</span>
                                        <span class="btn-browse">Обзор</span>
                                    </label>
                                </div>
                            </div>
                            <input type="hidden" id="moduleFileUrl">
                        </div>
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label">Галерея изображений</label>
                    <div class="gallery-upload-area">
                        <div class="upload-zone" id="uploadZone">
                            <i class="bi bi-cloud-upload"></i>
                            <p>Перетащите изображения сюда или нажмите для выбора</p>
                            <button type="button" class="btn-upload" onclick="document.getElementById('galleryImageInput').click()">
                                <i class="bi bi-plus"></i> Выбрать файлы
                            </button>
                            <input type="file" id="galleryImageInput" multiple accept="image/*" style="display: none;">
                        </div>
                    </div>
                    <div class="gallery-container" id="galleryContainer">
                        <div class="empty-gallery">
                            <i class="bi bi-images"></i>
                            <p>Нет изображений в галерее</p>
                        </div>
                    </div>
                </div>
            </form>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn btn-secondary" id="cancelModalBtn">Отмена</button>
            <button type="button" class="btn btn-primary" id="saveModuleBtn">Сохранить</button>
        </div>
    </div>
</div>

<!-- Modal for News -->
<div id="newsModal" class="modal-fullscreen" style="display: none;">
    <div class="modal-container">
        <div class="modal-header">
            <h3 id="newsModalTitle">Новость</h3>
            <button type="button" class="close-btn" id="closeNewsModalBtn">&times;</button>
        </div>
        <div class="modal-body">
            <form id="newsForm">
                <input type="hidden" id="newsId">

                <div class="form-group">
                    <label class="form-label">Заголовок *</label>
                    <input type="text" id="newsTitle" class="form-control" required>
                </div>

                <div class="form-group">
                    <label class="form-label">Модуль (опционально)</label>
                    <select id="newsModuleId" class="form-control">
                        <option value="">-- Все модули (общая новость) --</option>
                    </select>
                </div>

                <div class="form-group">
                    <label class="form-label">Изображение</label>
                    <div class="custom-file-input">
                        <div class="file-input-wrapper">
                            <input type="file" id="newsImageFile" accept="image/*">
                            <label for="newsImageFile" class="file-input-label" id="newsImageLabel">
                                <i class="bi bi-image"></i>
                                <span class="file-name">Выберите изображение...</span>
                                <span class="btn-browse">Обзор</span>
                            </label>
                        </div>
                    </div>
                    <div id="newsPreviewContainer" class="preview-container">
                        <div class="preview-placeholder">
                            <i class="bi bi-image"></i>
                            <p>Нет изображения</p>
                        </div>
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label">Содержание *</label>
                    <textarea id="newsContent" class="form-control" rows="8" required></textarea>
                </div>
            </form>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn btn-secondary" id="cancelNewsModalBtn">Отмена</button>
            <button type="button" class="btn btn-primary" id="saveNewsBtn">Сохранить</button>
        </div>
    </div>
</div>

<!-- Скрипты -->
<% if (isProduction) { %>
    <script src="/js/admin.min.js"></script>
<% } else { %>
    <script src="/js/admin.js"></script>
<% } %>

</body>
</html>